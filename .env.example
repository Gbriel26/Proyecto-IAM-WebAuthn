# ============================================================
# IAM Passwordless (WebAuthn/FIDO2) — configuración de ejemplo
# Copia este archivo a `.env` y ajusta los valores.
# ============================================================

# --- Servidor -------------------------------------------------
PORT=3000
NODE_ENV=development

# --- PostgreSQL ----------------------------------------------
# Crea la base antes de arrancar:
#   createdb iam_webauthn
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iam_webauthn

# --- Relying Party (WebAuthn) --------------------------------
# RP_ID debe ser el dominio sin esquema ni puerto. En local: localhost.
RP_ID=localhost
RP_NAME=IAM PyME

# Origen exacto del frontend. Puedes declarar varios separados por coma.
# El navegador envía el origin SIN barra final.
ORIGIN=http://localhost:3000
# ORIGIN=http://localhost:3000,https://iam.mipyme.com

# --- JWT (OBLIGATORIO) ---------------------------------------
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
SESSION_TTL_MS=3600000
JWT_ISSUER=iam-webauthn-cul
JWT_AUDIENCE=pyme-iam

# --- Cookie de sesión ----------------------------------------
SESSION_COOKIE_NAME=iam_token
# true en producción con HTTPS. En local (http://localhost) debe ser false.
COOKIE_SECURE=false

# --- Retos criptográficos ------------------------------------
# TTL de un solo uso para los challenges (5 minutos por defecto).
CHALLENGE_TTL_MS=300000

# --- Rate limiting -------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_STRICT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MAX=30

# --- Proxy inverso -------------------------------------------
# Si está detrás de Nginx/Cloudflare, indica el número de saltos (p. ej. 1)
# para que req.ip sea la IP real del cliente.
TRUST_PROXY=false

# --- Política de roles ---------------------------------------
# true  = modo demo: el alta pública puede elegir admin/gerencia/operativo.
# false = modo seguro: solo un admin autenticado (o el primer usuario) puede
#         asignar roles elevados. Un usuario existente solo puede añadir otra
#         llave después de iniciar sesión con su propia cuenta.
ALLOW_PUBLIC_ROLE_SELECTION=true
