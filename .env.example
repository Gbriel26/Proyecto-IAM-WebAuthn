# ============================================================
# ZISXA / IAM Passwordless (WebAuthn/FIDO2)
# Variables para producción en Railway.
#
# Pega estas variables en: Railway > tu servicio > Variables.
# Railway inyecta PORT y DATABASE_URL automáticamente; normalmente no
# necesitas definirlas a mano. Abajo se documenta su formato.
# ============================================================

# ============================================================
# PRODUCCIÓN RAILWAY (bloque activo)
# ============================================================

# --- Servidor -------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
# Railway asigna PORT. No lo definas manualmente en producción.
# En local puedes usar: PORT=3000
# PORT=3000

# --- PostgreSQL ----------------------------------------------
# Railway normalmente inyecta DATABASE_URL al vincular PostgreSQL.
# Si la defines manualmente, usa la Internal Database URL del servicio.
# También puedes usar la referencia: ${{Postgres.DATABASE_URL}}
# (ajusta "Postgres" al nombre real de tu servicio de BD).
DATABASE_URL=postgresql://usuario:clave@postgres.railway.internal:5432/railway

# auto  = SSL en hosts públicos; sin SSL en localhost y *.railway.internal.
# true  = forzar SSL.
# false = desactivar SSL.
DATABASE_SSL=auto

# Opcional: para verificar el certificado con una CA propia.
# Por defecto se usa rejectUnauthorized=false porque Railway usa
# certificados gestionados. Si defines DATABASE_SSL_CA, la verificación
# se activa automáticamente.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# --- Relying Party (WebAuthn) --------------------------------
# Dominio público de Railway, SIN https://, sin puerto y sin barra final.
# Ejemplo Railway: zisxa-production.up.railway.app
RP_ID=zisxa-production.up.railway.app
RP_NAME=ZISXA

# Origen exacto del frontend, CON https:// y SIN barra final.
# Debe coincidir con el dominio del servicio web de Railway.
ORIGIN=https://zisxa-production.up.railway.app

# --- JWT (OBLIGATORIO) ---------------------------------------
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
SESSION_TTL_MS=3600000
JWT_ISSUER=iam-webauthn-cul
JWT_AUDIENCE=pyme-iam

# --- Cookie de sesión ----------------------------------------
SESSION_COOKIE_NAME=iam_token
# true en producción con HTTPS (Railway).
COOKIE_SECURE=true

# --- Retos criptográficos ------------------------------------
CHALLENGE_TTL_MS=300000

# --- Rate limiting -------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_STRICT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MAX=30

# --- Proxy inverso -------------------------------------------
# Railway termina HTTPS en su proxy: confiar exactamente en 1 salto.
TRUST_PROXY=1

# --- Política de roles ---------------------------------------
# false = modo seguro en producción. Solo un admin autenticado o el
# primer usuario (bootstrap) puede asignar roles elevados.
ALLOW_PUBLIC_ROLE_SELECTION=false

# ============================================================
# DESARROLLO LOCAL (no pegar en Railway)
# ============================================================
# NODE_ENV=development
# PORT=3000
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/iam_webauthn
# DATABASE_SSL=false
# RP_ID=localhost
# ORIGIN=http://localhost:3000
# COOKIE_SECURE=false
# TRUST_PROXY=1
# ALLOW_PUBLIC_ROLE_SELECTION=true
