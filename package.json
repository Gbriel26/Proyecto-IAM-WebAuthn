{
  "name": "iam-webauthn",
  "version": "1.0.0",
  "description": "Sistema Centralizado de Identidad y Accesos (IAM) con Autenticación Passwordless (WebAuthn/FIDO2)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/initDb.js",
    "test": "node --test --test-concurrency=1 tests/integration.test.js tests/challengeStore.test.js tests/rateLimit.test.js tests/rolePolicy.test.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "keywords": [
    "webauthn",
    "fido2",
    "passkeys",
    "iam",
    "passwordless"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
